{
  "productName": "ClawLadder",
  "version": "0.1.21",
  "identifier": "com.clawladder.app",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": "bun run --cwd ../web build",
    "beforeDevCommand": "bun run --cwd ../web dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClawLadder",
        "width": 720,
        "height": 960,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "url": "http://127.0.0.1:3145",
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../web/dist": "web/dist",
      "../../openclaw/install.sh": "clawladder/install.sh"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
